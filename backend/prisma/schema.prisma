generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserYear {
  FIRST
  SECOND
  THIRD
  FOURTH
  POSTGRADUATE
}
enum UserRole {
  STUDENT
  TEACHER
  COLLEGE_ADMIN
  ADMIN
}
enum InstitutionStatus {
  ACTIVE
  INACTIVE
}
enum InstitutionInvitationRole {
  TEACHER
  STUDENT
}
enum InstitutionInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}
enum AcademicPeriodStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}
enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
}
enum AttendanceRecordStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
enum LectureType {
  LECTURE
  LAB
  TUTORIAL
  SEMINAR
}
enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}
enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}
enum ProjectStatus {
  IDEA
  RECRUITING
  ACTIVE
  COMPLETED
  PAUSED
}
enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
enum ProjectMemberRole {
  OWNER
  DEVELOPER
  DESIGNER
  ML_ENGINEER
  BACKEND_DEVELOPER
  FRONTEND_DEVELOPER
  OTHER
}
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
enum EventParticipantStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
}
enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  SCHOLARSHIP
  COMPETITION
  WORKSHOP
  FELLOWSHIP
}
enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  PROJECT_APPLICATION
  PROJECT_APPLICATION_ACCEPTED
  EVENT_REMINDER
  COMMUNITY_ACTIVITY
  MESSAGE
  SYSTEM
}

model User {
  id String @id @default(cuid())
  fullName String
  email String @unique
  passwordHash String
  googleSub String? @unique
  role UserRole @default(STUDENT)
  avatar String?
  bio String?
  college String?
  course String?
  year UserYear?
  location String?
  refreshTokenHash String?
  collegeId String?
  departmentId String?
  academicProgramId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills UserSkill[]
  interests UserInterest[]
  ownedCommunities Community[] @relation("CommunityOwner")
  communityMemberships CommunityMember[]
  ownedProjects Project[] @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  eventParticipants EventParticipant[]
  notifications Notification[]
  projectApplications ProjectApplication[]
  sentConnections Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionRecipient")
  posts Post[]
  comments Comment[]
  likes PostLike[]
  conversationMemberships ConversationMember[]
  sentMessages Message[]
  academicCollege College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  academicDepartment Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicProgram AcademicProgram? @relation(fields: [academicProgramId], references: [id], onDelete: SetNull)
  studentEnrollments StudentEnrollment[] @relation("StudentEnrollments")
  teachingAssignments TeachingAssignment[] @relation("TeacherAssignments")
  attendanceRecords AttendanceRecord[] @relation("StudentAttendanceRecords")
  createdSubjects Subject[] @relation("TeacherCreatedSubjects")
  createdClassSections ClassSection[] @relation("TeacherCreatedSections")
  classAccess TeacherClassAccess[] @relation("TeacherClassAccess")
  institutionInvitationsSent InstitutionInvitation[] @relation("InstitutionInviter")
  @@index([college, course])
  @@index([role])
  @@index([collegeId, departmentId, academicProgramId])
}

model College {
  id String @id @default(cuid())
  name String @unique
  code String? @unique
  slug String @unique
  shortName String
  city String?
  state String?
  country String?
  status InstitutionStatus @default(INACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  departments Department[]
  academicYears AcademicYear[]
  terms AcademicTerm[]
  users User[]
  invitations InstitutionInvitation[]
}

model InstitutionInvitation {
  id String @id @default(cuid())
  collegeId String
  email String
  role InstitutionInvitationRole
  tokenHash String @unique
  status InstitutionInvitationStatus @default(PENDING)
  expiresAt DateTime
  acceptedAt DateTime?
  invitedById String
  departmentId String?
  academicProgramId String?
  classSectionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InstitutionInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicProgram AcademicProgram? @relation(fields: [academicProgramId], references: [id], onDelete: SetNull)
  classSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  @@index([collegeId, status, role])
  @@index([email, status])
}

model Department {
  id String @id @default(cuid())
  collegeId String
  name String
  code String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  programs AcademicProgram[]
  subjects Subject[]
  users User[]
  invitations InstitutionInvitation[]
  @@unique([collegeId, name])
  @@unique([collegeId, code])
}

model AcademicProgram {
  id String @id @default(cuid())
  departmentId String
  name String
  code String?
  durationYears Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  classSections ClassSection[]
  users User[]
  invitations InstitutionInvitation[]
  @@unique([departmentId, name])
  @@unique([departmentId, code])
}

model AcademicYear {
  id String @id @default(cuid())
  collegeId String
  name String
  startsAt DateTime
  endsAt DateTime
  status AcademicPeriodStatus @default(UPCOMING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  terms AcademicTerm[]
  @@unique([collegeId, name])
  @@index([collegeId, status])
}

model AcademicTerm {
  id String @id @default(cuid())
  collegeId String
  academicYearId String?
  name String
  code String?
  startsAt DateTime
  endsAt DateTime
  isActive Boolean @default(false)
  status AcademicPeriodStatus @default(UPCOMING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classSections ClassSection[]
  @@unique([academicYearId, name])
  @@unique([academicYearId, code])
  @@index([collegeId, isActive])
  @@index([collegeId, status])
}

model ClassSection {
  id String @id @default(cuid())
  programId String
  termId String
  name String
  yearLevel Int?
  semester Int?
  createdByTeacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  term AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  createdByTeacher User? @relation("TeacherCreatedSections", fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  teacherAccess TeacherClassAccess[]
  invitations InstitutionInvitation[]
  @@unique([programId, termId, name])
  @@index([termId])
}

model Subject {
  id String @id @default(cuid())
  departmentId String
  code String
  name String
  description String?
  credits Int?
  createdByTeacherId String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  createdByTeacher User? @relation("TeacherCreatedSubjects", fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  @@unique([departmentId, code])
  @@index([departmentId, name])
}

model StudentEnrollment {
  id String @id @default(cuid())
  studentId String
  classSectionId String
  status EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime @default(now())
  completedAt DateTime?
  student User @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  @@unique([studentId, classSectionId])
  @@index([classSectionId, status])
}

model TeachingAssignment {
  id String @id @default(cuid())
  teacherId String
  subjectId String
  classSectionId String
  assignedAt DateTime @default(now())
  teacher User @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]
  timetableEntries TimetableEntry[]
  @@unique([teacherId, subjectId, classSectionId])
  @@index([classSectionId, subjectId])
}

model TeacherClassAccess {
  teacherId String
  classSectionId String
  canManage Boolean @default(true)
  grantedAt DateTime @default(now())
  teacher User @relation("TeacherClassAccess", fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  @@id([teacherId, classSectionId])
  @@index([classSectionId])
}

model TimetableEntry {
  id String @id @default(cuid())
  teachingAssignmentId String
  day Weekday
  startMinutes Int
  endMinutes Int
  room String?
  lectureType LectureType @default(LECTURE)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  @@index([teachingAssignmentId, day, startMinutes])
}

model AttendanceSession {
  id String @id @default(cuid())
  teachingAssignmentId String
  clientRequestId String @unique
  startsAt DateTime
  endsAt DateTime?
  status AttendanceSessionStatus @default(SUBMITTED)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]
  @@unique([teachingAssignmentId, startsAt])
  @@index([teachingAssignmentId, startsAt])
}

model AttendanceRecord {
  id String @id @default(cuid())
  attendanceSessionId String
  studentId String
  status AttendanceRecordStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student User @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([attendanceSessionId, studentId])
  @@index([studentId, status])
}

model Skill {
  id String @id @default(cuid())
  name String @unique
  users UserSkill[]
  projectSkills ProjectSkill[]
}

model Interest {
  id String @id @default(cuid())
  name String @unique
  users UserInterest[]
}

model UserSkill {
  userId String
  skillId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([userId, skillId])
}

model UserInterest {
  userId String
  interestId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  @@id([userId, interestId])
}

model Connection {
  id String @id @default(cuid())
  requesterId String
  recipientId String
  status ConnectionStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
}

model Community {
  id String @id @default(cuid())
  name String @unique
  description String
  image String?
  banner String?
  category String
  ownerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("CommunityOwner", fields: [ownerId], references: [id])
  members CommunityMember[]
  posts Post[]
  @@index([category])
}

model Post {
  id String @id @default(cuid())
  authorId String
  communityId String?
  content String
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  likes PostLike[]
  comments Comment[]
  @@index([createdAt])
  @@index([communityId, createdAt])
}

model PostLike {
  postId String
  userId String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
}

model Comment {
  id String @id @default(cuid())
  postId String
  authorId String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}

model CommunityMember {
  communityId String
  userId String
  role CommunityRole @default(MEMBER)
  joinedAt DateTime @default(now())
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([communityId, userId])
}

model Project {
  id String @id @default(cuid())
  title String
  description String
  ownerId String
  status ProjectStatus @default(IDEA)
  difficulty ProjectDifficulty @default(INTERMEDIATE)
  githubUrl String?
  demoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  skills ProjectSkill[]
  roles ProjectRole[]
  applications ProjectApplication[]
  @@index([status, difficulty])
}

model ProjectRole {
  id String @id @default(cuid())
  projectId String
  role ProjectMemberRole
  openPositions Int @default(1)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, role])
}

model ProjectApplication {
  id String @id @default(cuid())
  projectId String
  applicantId String
  role ProjectMemberRole
  message String?
  status ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  @@unique([projectId, applicantId])
  @@index([projectId, status])
}

model ProjectMember {
  projectId String
  userId String
  role ProjectMemberRole
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
}

model ProjectSkill {
  projectId String
  skillId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([projectId, skillId])
}

model Event {
  id String @id @default(cuid())
  title String
  description String
  banner String?
  category String
  organizerId String
  venue String
  location String
  startDate DateTime
  endDate DateTime
  registrationDeadline DateTime?
  maxParticipants Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants EventParticipant[]
  @@index([startDate, category])
}

model EventParticipant {
  eventId String
  userId String
  status EventParticipantStatus @default(REGISTERED)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([eventId, userId])
}

model Opportunity {
  id String @id @default(cuid())
  title String
  organization String
  description String
  type OpportunityType
  location String
  applicationUrl String
  deadline DateTime?
  image String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([type, deadline])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  message String
  data Json?
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, read, createdAt])
}

model Conversation {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ConversationMember[]
  messages Message[]
}
model ConversationMember {
  conversationId String
  userId String
  joinedAt DateTime @default(now())
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([conversationId,userId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  readAt DateTime?
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  sender User @relation(fields:[senderId],references:[id],onDelete:Cascade)
  @@index([conversationId,createdAt])
}
